PORT=5320
ACCESS_TOKEN_SECRET=access_token_secret
REFRESH_TOKEN_SECRET=refresh_token_secret
GINGER_API_BASE_URL=http://127.0.0.1:5001

# Optional: if business backend requires token header for internal calls
# GINGER_SERVICE_TOKEN=

# Signature verification config
MX_SIGN_SALT=mx-custom-v1
MX_MAX_CLOCK_SKEW_MS=600000
MX_NONCE_TTL_MS=600000

# SQLite storage path (can be absolute path)
# RBAC_DB_FILE=.data/rbac.sqlite
