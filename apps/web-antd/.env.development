# 端口号
VITE_PORT=5666

VITE_BASE=/

# 前端缓存命名空间（变更后可清空旧会话缓存）
VITE_APP_NAMESPACE=vben-web-antd-maixu-20260228b

# 接口地址
VITE_GLOB_API_URL=/api

# 麦序业务后端（通过 /api/ginger 走受控代理）
VITE_GINGER_API_URL=/api/ginger

# 自定义签名盐值（需和后端 MX_SIGN_SALT 保持一致）
VITE_MX_SIGN_SALT=mx-custom-v1

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=true

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
