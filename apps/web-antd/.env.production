VITE_BASE=/

# 接口地址（生产建议走同域反向代理）
VITE_GLOB_API_URL=/api

# 麦序业务接口地址（生产建议走同域反向代理）
VITE_GINGER_API_URL=/api/ginger

# 自定义签名盐值（需和后端 MX_SIGN_SALT 保持一致）
VITE_MX_SIGN_SALT=mx-custom-v1

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
