# Frontend host port
FRONTEND_PORT=5666

# Backend proxy target (business service)
# Example: if your business backend test endpoint is http://192.168.2.195:5001/v1/test,
# then set GINGER_API_BASE_URL=http://192.168.2.195:5001
GINGER_API_BASE_URL=http://host.docker.internal:5001

# Optional service token for ginger backend
GINGER_SERVICE_TOKEN=

# JWT secrets (must change in production)
ACCESS_TOKEN_SECRET=replace_with_strong_access_secret
REFRESH_TOKEN_SECRET=replace_with_strong_refresh_secret

# Signature config (frontend and backend must match)
MX_SIGN_SALT=replace_with_sign_salt
MX_MAX_CLOCK_SKEW_MS=600000
MX_NONCE_TTL_MS=600000

# SQLite persistence path inside container
RBAC_DB_FILE=/data/rbac.sqlite

# Built-in MySQL container config
MYSQL_PORT_HOST=13306
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=vben_prod
MYSQL_USERNAME=vben
MYSQL_PASSWORD=change_me_app

# Backend MySQL env (already points to the internal mysql service)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_SSL=false
MYSQL_CHARSET=utf8mb4
MYSQL_URL=mysql://vben:change_me_app@mysql:3306/vben_prod?charset=utf8mb4

# Optional if deploy under sub path
VITE_BASE=/
